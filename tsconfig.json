{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": [
    "schema.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "eslint.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "telegram-dist"]
}

