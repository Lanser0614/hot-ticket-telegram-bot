SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/10 * * * * hotticket /bin/bash -c 'set -a; source /etc/hot-ticket-bot.env; cd /opt/hot-ticket-bot; exec /usr/bin/flock -n /run/lock/hot-ticket-bot-sync.lock /usr/bin/node dist/entries/sync.js'
30 3 * * * hotticket /bin/bash -c 'set -a; source /etc/hot-ticket-bot.env; cd /opt/hot-ticket-bot; exec /usr/bin/node dist/entries/backup.js'
