{
  "name": "hot-ticket-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "backup": "node --env-file-if-exists=.env dist/entries/backup.js",
    "start": "node --env-file-if-exists=.env dist/entries/bot.js",
    "start:admin": "node --env-file-if-exists=.env dist/entries/admin.js",
    "start:web": "node --env-file-if-exists=.env dist/entries/web.js",
    "sync": "node --env-file-if-exists=.env dist/entries/sync.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "generate:iata": "node scripts/generate-iata-map.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/icons": "^3.46.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "csv-parse": "^7.0.2",
    "express": "^5.1.0"
  }
}
